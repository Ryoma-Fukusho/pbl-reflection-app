# このファイルは「どの環境変数が必要か」を示すテンプレートです。
# 実際の値は .env.local に書きます（.env.local は .gitignore 済みで git に上がりません）。
# Vercel にデプロイする際は、同じ内容を Vercel の Settings → Environment Variables にも登録し、
# その後に再デプロイしてください（NEXT_PUBLIC_* はビルド時にバンドルへ焼き込まれるため）。

# ---------------------------------------------------------------------------
# Claude API (Anthropic)
#
# 取得場所: https://platform.claude.com/ → Settings → API keys
#
# CLAUDE_MODEL は任意。未設定なら claude-sonnet-5 を使います。
# 応答品質を比較したいときだけ CLAUDE_MODEL=claude-opus-5 に差し替えてください。
#
# CLAUDE_EFFORT も任意。low / medium / high / xhigh / max のいずれかで、
# 未設定なら medium。値を上げるほど思考に使うトークンが増え、品質・費用・
# 応答時間がすべて増えます。実際に使った値は sessions.effort に記録されます。
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_EFFORT=medium

# ---------------------------------------------------------------------------
# Firebase クライアント設定（ブラウザに露出する / 秘密ではない）
#
# 取得場所: Firebase コンソール → プロジェクト設定(⚙) → 全般 → マイアプリ → ウェブアプリ
# ここに表示される firebaseConfig の値をそのまま貼ります。
# これは「どの Firebase プロジェクトか」を指す住所であり、公開されて構いません。
# 実際の防御は firestore.rules（全面 deny）とサーバー側のトークン検証が担います。
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase Admin（サーバー専用 / 本物の秘密）
#
# 取得場所: Firebase コンソール → プロジェクト設定(⚙) → サービスアカウント
#           → 「新しい秘密鍵の生成」でダウンロードされる JSON の中身
#
# 警告:
#   - これを持っていれば全データを読み書きできます
#   - 絶対に NEXT_PUBLIC_ を付けないこと（付けるとブラウザに公開されます）
#   - ダウンロードした JSON ファイル自体をリポジトリに置かないこと
#
# FIREBASE_PRIVATE_KEY は改行を含むため、必ずダブルクォートで囲んでください。
# JSON 内の "private_key" の値をそのまま（\n を含んだ状態で）貼れば動きます。
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nここに貼る\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# 大学ドメイン判定（カンマ区切り / 任意）
#
# ログインしたアカウントのメールドメインがここに一致すると
# users ドキュメントに isUniversityAccount: true が立ちます。
# ログイン自体を制限するものではありません（Gmail でもログインできます）。
# 例: UNIVERSITY_EMAIL_DOMAINS=example.ac.jp,st.example.ac.jp
# ---------------------------------------------------------------------------
UNIVERSITY_EMAIL_DOMAINS=
